{
  "name": "securio",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "description": "Une application sécurisée pour chiffrer et déchiffrer vos fichiers sensibles",
  "author": "SkY1331",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "electron . --dev",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test test/crypto.test.mjs",
    "lint": "eslint .",
    "electron:build": "npm run build && electron-builder --win portable --x64",
    "electron:build:installer": "npm run build && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.securio.app",
    "productName": "Securio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "asar": true,
    "fileAssociations": [
      {
        "ext": "encrypted",
        "name": "Fichier Securio",
        "description": "Fichier chiffré par Securio",
        "role": "Editor",
        "icon": "public/icon.ico"
      }
    ],
    "win": {
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "Securio-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Securio-${version}-setup.exe"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.8"
  }
}
